        <Text>
          <eid>NoZDflnyE7F_23xSDoaSS1</eid>
          <style>frame</style>
          <align>center,top</align>
          <offset x="0" y="3.49956"/>
          <position>center</position>
          <text><font size="37"/>Por Elas e pra Elas<br/><font size="30"/>Simone Almeida <br/></text>
          </Text>
        </VBox>
      <VBox>
        <height>76</height>
        <bottomGap>14</bottomGap>
        <boxAutoSize>0</boxAutoSize>
        <eid>jcm6N37kl7L_b4szJy1i9aO</eid>
        <Text>
          <eid>VhgDmchxc7N_Xi2xQ9X5L3N</eid>
          <style>frame</style>
          <size>15</size>
          <align>center,top</align>
          <offset x="-3.49956" y="3.49956"/>
          <position>center</position>
          <text><font size="15"/>Monalisa<br/>⁠Flor negra<br/>⁠Super-homem a canção<br/>⁠Tigresa<br/>⁠Vitoriosa<br/>⁠Rosa<br/>⁠Meu grande amor<br/>⁠Madalena<br/>⁠Aos olhos do pai<br/>⁠Luiza<br/>⁠Dona<br/>⁠Cor de rosa-choque <br/>⁠Feminina<br/>⁠Dona da minha cabeça <br/>⁠Você é linda<br/>⁠Coisa linda<br/>⁠Fugaz<br/>⁠Maria, Maria<br/>⁠Céu estrelado<br/>⁠Olhares Velozes</text>
          </Text>
        </VBox>
