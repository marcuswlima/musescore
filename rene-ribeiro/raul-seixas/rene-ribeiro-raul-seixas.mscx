    <Staff id="1">
      <VBox>
        <height>146.144</height>
        <boxAutoSize>0</boxAutoSize>
        <eid>MDOS+U5R3pL_uB4lAoaORZM</eid>
        <Text>
          <eid>rRddTMmXKjE_biMSTqfrZAE</eid>
          <style>frame</style>
          <offset x="72.5485" y="90.639"/>
          <text>01. Meu Amigo Pedro<br/>02. Ouro de Tolo<br/>03. Eu nasci há dez mil anos atrás<br/>04. Eu também vou reclamar<br/>05. Sociedade Alternativa<br/>06. Mosca na Sopa<br/>07. Al Capone<br/>08. O Trem das Sete<br/>09. A Maçã<br/>10. Maluco beleza<br/>11. Let Me Sing<br/>12. Como vovó já dizia<br/>13. Seper Heróis<br/>14. Abre-te Sesamo<br/>15. Gita<br/>16. Capim Guiné<br/>17. Medo da Chuva<br/>18. O dia que a terra parou<br/>19. Metamorfose Ambulante<br/>20. Pastor João e a Igreja Invisível<br/>21. Tente Outra Vez<br/>22. Paranóia<br/>23. Aluga-se<br/>24. Carimbador Maluco<br/>23.Cawboy Fara da Lei<br/></text>
          </Text>
        <Text>
          <eid>/UN3iUH1CMH_ocR6FGaXfyJ</eid>
          <style>frame</style>
          <size>27</size>
          <bold>1</bold>
          <align>center,top</align>
          <offset x="36.9694" y="35.0896"/>
          <text><b><font size="27"/>Metamorfose ambulante - <br/>Tributo Raul Seixas por<br/>René Ribeiro</b></text>
          </Text>
        <Text>
          <eid>fci5jLbg9UD_7PftUIplDbD</eid>
          <style>frame</style>
          <bold>1</bold>
          <align>center,top</align>
          <offset x="81.4581" y="226.829"/>
          <text><b>Belém<br/>Café Santo<br/>Ago/2026</b></text>
          </Text>
        </VBox>
